PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/preparena
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:8080

# Judge0 base URL (for example, a trusted self-hosted instance on localhost:2358).
# Leave unset until a Judge0 service is available; execution then returns HTTP 503.
JUDGE0_API_URL=
# Optional: X-Auth-Token for self-hosted Judge0, or RapidAPI key with JUDGE0_API_HOST.
JUDGE0_API_KEY=
JUDGE0_API_HOST=
